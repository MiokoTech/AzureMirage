# Konfigurasi Karakter Azure Mirage (Dikonversi otomatis 1:1 dari saber.swf)
[Character]
id = "Artoria Pendragon (Saber)"
name = "Artoria Pendragon"
author = "MiokoTech"
version = "1.0"
scale = 2.0
default_form = "base"

[Assets]
sprites = "saber.amp"
animation = "saber.ama"
script = "saber.ams"
