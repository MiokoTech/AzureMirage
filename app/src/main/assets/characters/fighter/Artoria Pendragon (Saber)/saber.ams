  on_frame 32:
    play_sound("sfx_0967")
    fx_screen_flash(color = 0xFFFFFF)
  on_frame 33:
    play_sound("sfx_1019")
    fx_camera_shake(amp_x = 5, amp_y = 5)
  on_frame 34:
    play_sound("sfx_1023")
    play_sound("sfx_1024")
  on_frame 62:
