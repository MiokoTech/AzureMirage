[Timeline "ultimate_skill"]
  on_frame 1:
    play_sound("sfx_1027")
  on_frame 2:
    play_sound("sfx_1028")
  on_frame 3:
    fx_super_cutin(is_ultimate = true, portrait = "cutin_saber1")
  on_frame 8:
    play_sound("sfx_0679")
  on_frame 9:
    play_sound("sfx_0443")
  on_frame 112:
    play_sound("sfx_0443")
  on_frame 175:
    fx_end_cutin()
  on_frame 177:
    fx_screen_flash(color = 0xFFFFFF)
    fx_screen_flash(color = 0x049FF7)
  on_frame 180:
    play_sound("sfx_0967")
    fx_camera_shake(amp_x = 5, amp_y = 5)
  on_frame 184:
    play_sound("sfx_1019")
  on_frame 185:
    play_sound("sfx_1024")
  on_frame 293:
    return_idle()

[Timeline "down_getup"]
  on_frame 5:
    return_idle()

[Timeline "recover"]
  on_frame 1:
    play_sound("sfx_1362")
  on_frame 2:
    set_velocity_percent(-1, 0)
    set_damping_percent(-0.1, 0)
  on_frame 12:
    return_idle()

[Timeline "intro"]
  on_frame 2:
    play_sound("sfx_1367")
  on_frame 5:
    play_sound("sfx_0396")
  on_frame 16:
    play_sound("sfx_0602")
  on_frame 30:
    play_sound("sfx_0387")
  on_frame 42:
    play_sound("sfx_0176")
  on_frame 54:
    return_idle()

[Timeline "win"]
  on_frame 1:
    play_sound("sfx_1451")
  on_frame 20:
    stop_timeline()

[Timeline "lose"]
  on_frame 12:
    stop_timeline()

[Timeline "awakening_unused"]
  on_frame 5:
    fx_awaken_cutin(portrait = "cutin_awaken")
  on_frame 24:
    play_sound("sfx_1467")
    fx_screen_flash(color = 0xFFFF00)
    fx_camera_shake(amp_x = 0, amp_y = 3)
  on_frame 139:
    transform_form("awakened_1")
